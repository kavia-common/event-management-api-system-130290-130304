# Copy this file to .env and adjust values. The orchestrator will inject real values.
APP_NAME=Event Management API
APP_DESCRIPTION=API system for managing events and attendees with authentication.
APP_VERSION=1.0.0
API_PREFIX=/api

# SECURITY
# IMPORTANT: Set a strong random secret key in production
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# DATABASE
# SQLite file path by default. For Postgres, use postgresql+psycopg2://user:pass@host:port/dbname
DATABASE_URL=sqlite:///./event_db.sqlite3

# Optional site URL for redirects if you have a frontend
SITE_URL=http://localhost:3000
